# AIDX経営エージェントシステム - 環境変数設定
# このファイルを .env にコピーして、APIキーを記入してください
# cp .env.example .env

# Anthropic API Key（必須）
# https://console.anthropic.com/ で取得
ANTHROPIC_API_KEY=sk-ant-xxxxx

# モデル設定（任意）
# デフォルト: claude-sonnet-4-20250514
AIDX_MODEL=claude-sonnet-4-20250514

# Google API Key（Phase 3: MCP連携時に使用）
# GOOGLE_API_KEY=

# Slack Token（Phase 3: MCP連携時に使用）
# SLACK_TOKEN=
