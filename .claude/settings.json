{
  "permissions": {
    "allow": [
      "Bash(git clone:*)",
      "Bash(git init:*)",
      "Bash(git remote:*)",
      "Bash(git fetch:*)",
      "Bash(cp -r everything-claude-code/* everything-claude-code/.* .)",
      "Bash(rm -rf everything-claude-code)",
      "Bash(rm -rf .git/modules)",
      "Bash(rm -f .gitmodules)",
      "Bash(git add:*)",
      "Bash(git commit -m ':*)",
      "Bash(git push:*)",
      "Bash(pip3 install:*)",
      "Bash(node tests/run-all.js)",
      "Bash(npm test:*)",
      "Bash(npm run:*)",
      "Bash(npm install:*)",
      "Bash(node scripts/ci/*)"
    ]
  },
  "plugins": {
    "claude-mem@thedotmack": false
  }
}
